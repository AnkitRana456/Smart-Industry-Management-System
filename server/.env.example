NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sims
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:5173
FACTORY_TIMEZONE=Asia/Kolkata
# Optional trained risk model (see ml-service/README.md). Leave ML_SERVICE_URL empty to switch it off.
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=
ML_TIMEOUT_MS=5000

# Gemini (server-side only, never expose to the client).
# Run `npm run ai:models` with a key set to list the model IDs your key can use,
# then set GEMINI_MODEL to one of them. There is deliberately no default.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000
# 0 turns thinking off (default; faster, and thinking tokens would eat the output limit). Use "default" to let the model decide.
GEMINI_THINKING_BUDGET=0
# Requests per minute your plan allows (the free tier is 5). Calls queue instead of failing. 0 = no limit.
GEMINI_MAX_RPM=0
